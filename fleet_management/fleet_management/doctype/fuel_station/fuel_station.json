{
 "allow_import": 1,
 "doctype": "DocType",
 "engine": "InnoDB",
 "field_order": [
  "station_name",
  "operational_location",
  "also_serves",
  "active",
  "approved",
  "address_section",
  "address_html"
 ],
 "fields": [
  {
   "fieldname": "station_name",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Station Name",
   "reqd": 1,
   "unique": 1
  },
  {
   "fieldname": "operational_location",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Operational Location",
   "options": "Fleet Location",
   "reqd": 1
  },
  {
   "description": "Other locations whose vehicles may be sent to this station, besides its operational location.",
   "fieldname": "also_serves",
   "fieldtype": "Table MultiSelect",
   "label": "Also Serves",
   "options": "Fuel Station Location"
  },
  {
   "default": "1",
   "fieldname": "active",
   "fieldtype": "Check",
   "in_list_view": 1,
   "label": "Active"
  },
  {
   "default": "1",
   "fieldname": "approved",
   "fieldtype": "Check",
   "in_list_view": 1,
   "label": "Approved"
  },
  {
   "fieldname": "address_section",
   "fieldtype": "Section Break",
   "label": "Address"
  },
  {
   "fieldname": "address_html",
   "fieldtype": "HTML",
   "label": "Address HTML"
  }
 ],
 "module": "Fleet Management",
 "name": "Fuel Station",
 "autoname": "field:station_name",
 "naming_rule": "By fieldname",
 "permissions": [
  {
   "create": 1,
   "delete": 1,
   "export": 1,
   "import": 1,
   "print": 1,
   "read": 1,
   "report": 1,
   "role": "Fleet Admin",
   "write": 1
  },
  {
   "print": 1,
   "report": 1,
   "read": 1,
   "role": "Fleet Approver"
  },
  {
   "read": 1,
   "role": "Fleet User"
  }
 ],
 "sort_field": "station_name",
 "sort_order": "ASC",
 "track_changes": 1
}
